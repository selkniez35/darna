<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Darna{% endblock %}</title>
        <meta name="description" content="{% block description %}Darna, les petites annonces entre particuliers au Maroc : immobilier, véhicules et plus encore.{% endblock %}">
        <meta name="theme-color" content="#fcfaf6">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 28 32%22><path d=%22M2 31V14C2 7.4 7.4 2 14 2s12 5.4 12 12v17%22 fill=%22none%22 stroke=%22%23c0583a%22 stroke-width=%223%22 stroke-linecap=%22round%22/><path d=%22M14 11l1.8 4.2L20 17l-4.2 1.8L14 23l-1.8-4.2L8 17l4.2-1.8z%22 fill=%22%23c0583a%22/></svg>">
        {% block stylesheets %}
            {{ vite_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ vite_entry_script_tags('app') }}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        {% endif %}
    </head>
    <body class="flex min-h-screen flex-col">
        <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-ink-900 focus:px-5 focus:py-2.5 focus:text-sm focus:font-medium focus:text-sand-50">
            Aller au contenu
        </a>
        {% block header %}{% include 'partials/_header.html.twig' %}{% endblock %}
        <main id="contenu" class="flex-1">
            {% block flashes %}{% include 'partials/_flashes.html.twig' %}{% endblock %}
            {#
                Les pages pleine largeur (accueil) surchargent « body ».
                Les autres remplissent « content », centré dans le conteneur commun.
            #}
            {% block body %}
                <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 lg:py-14">
                    {% block content %}{% endblock %}
                </div>
            {% endblock %}
        </main>
        {% block footer %}{% include 'partials/_footer.html.twig' %}{% endblock %}
    </body>
</html>
