<header class="sticky top-0 z-40 border-b border-sand-200/70 bg-sand-50/85 backdrop-blur-md"
        data-controller="menu" data-action="keydown@window->menu#close turbo:before-cache@document->menu#close">
    {% set route = app.request.attributes.get('_route', '') %}
    {% set on_listings = route starts with 'app_listing_' and route != 'app_listing_new' %}
    <div class="mx-auto flex h-18 max-w-6xl items-center justify-between px-5 sm:px-8">
        {% include 'partials/_logo.html.twig' %}

        <nav class="hidden items-center gap-9 text-sm font-medium text-ink-700 md:flex" aria-label="Navigation principale">
            <a href="{{ path('app_listing_index') }}" class="transition-colors hover:text-clay-600 aria-[current=page]:text-clay-600"{% if on_listings %} aria-current="page"{% endif %}>Annonces</a>
            <a href="/#categories" class="transition-colors hover:text-clay-600">Catégories</a>
            <a href="/#fonctionnement" class="transition-colors hover:text-clay-600">Comment ça marche</a>
        </nav>

        <div class="flex items-center gap-2">
            <a href="{{ path('app_listing_new') }}"
               class="hidden rounded-full bg-ink-900 px-5 py-2.5 text-sm font-medium text-sand-50 transition hover:bg-clay-600 sm:inline-flex">
                Déposer une annonce
            </a>
            <button type="button" class="inline-flex size-10 items-center justify-center rounded-full text-ink-900 hover:bg-sand-100 md:hidden"
                    data-menu-target="button" data-action="menu#toggle" aria-expanded="false" aria-controls="menu-mobile" aria-label="Ouvrir le menu">
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                    <path d="M4 7h16M4 12h16M4 17h10" data-menu-target="openIcon"/>
                    <path d="M6 6l12 12M18 6L6 18" data-menu-target="closeIcon" hidden/>
                </svg>
            </button>
        </div>
    </div>

    <nav id="menu-mobile" class="border-t border-sand-200 px-5 pb-6 pt-2 md:hidden" data-menu-target="panel" hidden aria-label="Navigation mobile">
        <a href="{{ path('app_listing_index') }}" class="block py-3 text-base font-medium text-ink-900 aria-[current=page]:text-clay-600"{% if on_listings %} aria-current="page"{% endif %}>Annonces</a>
        <a href="/#categories" class="block py-3 text-base font-medium text-ink-900" data-action="menu#close">Catégories</a>
        <a href="/#fonctionnement" class="block py-3 text-base font-medium text-ink-900" data-action="menu#close">Comment ça marche</a>
        <a href="{{ path('app_listing_new') }}" class="mt-3 flex justify-center rounded-full bg-clay-500 px-5 py-3 text-sm font-medium text-white">Déposer une annonce</a>
    </nav>
</header>
