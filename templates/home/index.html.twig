{% extends 'base.html.twig' %}

{#
    Variables optionnelles, fournies par le contrôleur :
    - categories      : Category[]  catégories à afficher (sinon la section est masquée)
    - latest_listings : Listing[]   dernières annonces publiées (sinon la section est masquée)
#}
{% set categories = categories|default([]) %}
{% set latest_listings = latest_listings|default([]) %}
{% set cities = [
    { name: 'Casablanca', ar: 'الدار البيضاء' },
    { name: 'Marrakech', ar: 'مراكش' },
    { name: 'Rabat', ar: 'الرباط' },
    { name: 'Tanger', ar: 'طنجة' },
    { name: 'Fès', ar: 'فاس' },
    { name: 'Agadir', ar: 'أكادير' },
] %}

{% block title %}Darna · Petites annonces au Maroc{% endblock %}

{% block body %}
    {# ── Hero ─────────────────────────────────────────────── #}
    <section class="relative overflow-hidden">
        <div class="mx-auto grid max-w-6xl items-center gap-14 px-5 pb-20 pt-14 sm:px-8 lg:grid-cols-[1.15fr_1fr] lg:gap-10 lg:pb-28 lg:pt-20">
            <div>
                <p class="inline-flex items-center gap-2 rounded-full border border-sand-300 bg-white/60 px-3.5 py-1.5 text-xs font-medium text-ink-700">
                    <span class="size-1.5 rounded-full bg-clay-500"></span>
                    Petites annonces entre particuliers
                </p>
                <h1 class="mt-7 font-display text-5xl font-medium leading-[1.02] tracking-tight text-ink-900 sm:text-6xl lg:text-7xl">
                    Trouvez votre place,
                    <span class="italic text-clay-500">au Maroc.</span>
                </h1>
                <p class="mt-6 max-w-md text-lg leading-relaxed text-ink-500">
                    Achetez, vendez, louez en toute simplicité, de Tanger à Dakhla.
                </p>

                <form action="{{ path('app_listing_index') }}" method="get" role="search"
                      class="mt-10 flex flex-col gap-2 rounded-3xl border border-sand-200 bg-white p-2 shadow-[0_18px_50px_-24px_rgba(31,26,23,0.35)] sm:flex-row sm:items-center sm:rounded-full">
                    <label class="flex flex-1 items-center gap-3 px-4 py-2.5">
                        <svg class="size-5 shrink-0 text-ink-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5" stroke-linecap="round"/></svg>
                        <span class="sr-only">Que cherchez-vous ?</span>
                        <input type="search" name="q" placeholder="Que cherchez-vous ?" class="w-full bg-transparent text-ink-900 placeholder:text-ink-500/70 focus:outline-none">
                    </label>
                    <span class="hidden h-7 w-px bg-sand-200 sm:block" aria-hidden="true"></span>
                    <label class="flex items-center gap-3 border-t border-sand-100 px-4 py-2.5 sm:w-44 sm:border-0">
                        <svg class="size-5 shrink-0 text-ink-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5a7 7 0 1 0-14 0C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.3"/></svg>
                        <span class="sr-only">Ville</span>
                        <select name="city" class="w-full cursor-pointer appearance-none bg-transparent text-ink-900 focus:outline-none">
                            <option value="">Tout le Maroc</option>
                            {% for city in cities %}
                                <option value="{{ city.name }}">{{ city.name }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <button type="submit" class="rounded-full bg-clay-500 px-7 py-3.5 text-sm font-semibold text-white transition hover:bg-clay-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-clay-500">
                        Rechercher
                    </button>
                </form>

                {% if categories is not empty %}
                    <div class="mt-6 flex flex-wrap items-center gap-2 text-sm">
                        <span class="text-ink-500">Populaire :</span>
                        {% for category in categories|slice(0, 4) %}
                            <a href="{{ path('app_listing_index', { category: category.slug }) }}"
                               class="rounded-full px-3 py-1 text-ink-700 underline decoration-sand-300 underline-offset-4 transition hover:text-clay-600 hover:decoration-clay-500">
                                {{ category.name }}
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            {# Composition : arc outrepassé en bleu Majorelle avec motif zellige #}
            <div class="relative mx-auto w-full max-w-sm lg:max-w-none" aria-hidden="true">
                <div class="relative mx-auto aspect-[4/5] w-[82%] overflow-hidden arch bg-majorelle-600">
                    <div class="absolute inset-0 zellige"></div>
                    <div class="absolute inset-x-[14%] bottom-0 top-[14%] arch border border-white/25 border-b-0 rounded-b-none"></div>
                    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-majorelle-900/50 to-transparent"></div>
                    <svg class="absolute left-1/2 top-[40%] size-16 -translate-x-1/2 -translate-y-1/2 text-white/90" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3l2.6 6.3L21 12l-6.4 2.7L12 21l-2.6-6.3L3 12l6.4-2.7z"/></svg>
                </div>
                <div class="absolute -right-2 top-[12%] size-24 rounded-full bg-clay-500/90 blur-[1px] sm:-right-4 sm:size-28"></div>
                <div class="absolute -left-2 bottom-[9%] w-56 rounded-2xl border border-sand-200 bg-white/95 p-4 shadow-[0_20px_40px_-20px_rgba(31,26,23,0.45)] backdrop-blur sm:-left-6">
                    <p class="text-xs font-medium uppercase tracking-[0.14em] text-ink-500">De Tanger à Dakhla</p>
                    <div class="mt-3 flex -space-x-2">
                        {% for city in cities|slice(0, 4) %}
                            <span class="flex size-8 items-center justify-center rounded-full border-2 border-white bg-sand-100 font-display text-xs font-semibold text-clay-600">{{ city.name|first }}</span>
                        {% endfor %}
                    </div>
                    <p class="mt-3 text-sm text-ink-700">Des annonces dans tout le Royaume.</p>
                </div>
            </div>
        </div>
    </section>

    {# ── Catégories ───────────────────────────────────────── #}
    {% if categories is not empty %}
        <section id="categories" class="scroll-mt-24 border-t border-sand-200/70 bg-white">
            <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 lg:py-24">
                <div class="flex items-end justify-between gap-6">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-clay-500">Catégories</p>
                        <h2 class="mt-3 font-display text-3xl font-medium tracking-tight sm:text-4xl">Par où commencer ?</h2>
                    </div>
                    <a href="{{ path('app_listing_index') }}" class="hidden shrink-0 text-sm font-medium text-ink-700 hover:text-clay-600 sm:inline-flex">Toutes les annonces →</a>
                </div>
                <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    {% for category in categories %}
                        <a href="{{ path('app_listing_index', { category: category.slug }) }}"
                           class="group flex items-center gap-5 rounded-3xl border border-sand-200 bg-sand-50 p-6 transition hover:-translate-y-0.5 hover:border-clay-500/40 hover:bg-white hover:shadow-[0_18px_40px_-24px_rgba(31,26,23,0.4)]">
                            <span class="flex size-14 shrink-0 items-center justify-center rounded-t-full rounded-b-xl bg-clay-50 text-clay-600 transition group-hover:bg-clay-500 group-hover:text-white">
                                {% include 'home/_category_icon.html.twig' with { slug: category.slug } %}
                            </span>
                            <span class="flex-1">
                                <span class="block font-display text-xl font-medium text-ink-900">{{ category.name }}</span>
                                <span class="mt-0.5 block text-sm text-ink-500">Voir les annonces</span>
                            </span>
                            <span class="text-ink-500 transition group-hover:translate-x-1 group-hover:text-clay-600" aria-hidden="true">→</span>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    {# ── Dernières annonces ───────────────────────────────── #}
    {% if latest_listings is not empty %}
        <section class="mx-auto max-w-6xl px-5 py-20 sm:px-8 lg:py-24">
            <div class="flex items-end justify-between gap-6">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-clay-500">Nouveautés</p>
                    <h2 class="mt-3 font-display text-3xl font-medium tracking-tight sm:text-4xl">Dernières annonces</h2>
                </div>
                <a href="{{ path('app_listing_index') }}" class="shrink-0 text-sm font-medium text-ink-700 hover:text-clay-600">Tout voir →</a>
            </div>
            <div class="mt-10 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
                {% for listing in latest_listings %}
                    {% include 'home/_listing_card.html.twig' %}
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {# ── Villes ───────────────────────────────────────────── #}
    <section id="villes" class="scroll-mt-24 border-y border-sand-200/70 bg-sand-100/60">
        <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 lg:py-24">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-clay-500">Villes</p>
            <h2 class="mt-3 font-display text-3xl font-medium tracking-tight sm:text-4xl">Près de chez vous</h2>
            <ul class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-3xl border border-sand-200 bg-sand-200 sm:grid-cols-3">
                {% for city in cities %}
                    <li>
                        <a href="{{ path('app_listing_index', { city: city.name }) }}"
                           class="group flex h-full items-center justify-between gap-3 bg-sand-50 px-6 py-7 transition hover:bg-white">
                            <span>
                                <span class="block font-display text-xl font-medium text-ink-900 transition group-hover:text-clay-600">{{ city.name }}</span>
                                <span lang="ar" dir="rtl" class="mt-1 block text-sm text-ink-500">{{ city.ar }}</span>
                            </span>
                            <span class="text-ink-500 opacity-0 transition group-hover:translate-x-1 group-hover:opacity-100" aria-hidden="true">→</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </section>

    {# ── Comment ça marche ────────────────────────────────── #}
    <section id="fonctionnement" class="scroll-mt-24 mx-auto max-w-6xl px-5 py-20 sm:px-8 lg:py-24">
        <div class="max-w-xl">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-clay-500">Comment ça marche</p>
            <h2 class="mt-3 font-display text-3xl font-medium tracking-tight sm:text-4xl">Simple comme un thé à la menthe.</h2>
        </div>
        <ol class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
            {% for step in [
                { title: 'Publiez', text: 'Décrivez votre bien, fixez votre prix : votre annonce est en ligne en quelques minutes.' },
                { title: 'Échangez', text: 'Les acheteurs intéressés vous contactent directement, sans intermédiaire.' },
                { title: 'Concluez', text: 'Rencontrez-vous, faites affaire. C’est aussi simple que ça.' },
            ] %}
                <li class="relative border-t border-sand-300 pt-6">
                    <span class="font-display text-sm font-semibold text-clay-500">0{{ loop.index }}</span>
                    <h3 class="mt-2 font-display text-2xl font-medium text-ink-900">{{ step.title }}</h3>
                    <p class="mt-3 leading-relaxed text-ink-500">{{ step.text }}</p>
                </li>
            {% endfor %}
        </ol>
    </section>

    {# ── Appel à l'action ─────────────────────────────────── #}
    <section class="px-5 pb-20 sm:px-8 lg:pb-24">
        <div class="relative mx-auto max-w-6xl overflow-hidden rounded-[2rem] bg-majorelle-600 px-8 py-16 text-center sm:px-16 lg:py-20">
            <div class="absolute inset-0 zellige opacity-70" aria-hidden="true"></div>
            <div class="relative">
                <h2 class="mx-auto max-w-2xl font-display text-3xl font-medium tracking-tight text-white sm:text-5xl">
                    Vous avez quelque chose à vendre&nbsp;?
                </h2>
                <p class="mx-auto mt-5 max-w-md text-lg text-white/75">
                    Déposez votre annonce en quelques minutes et touchez des acheteurs partout au Maroc.
                </p>
                <a href="{{ path('app_listing_new') }}"
                   class="mt-9 inline-flex rounded-full bg-sand-50 px-8 py-4 text-sm font-semibold text-ink-900 transition hover:bg-clay-500 hover:text-white">
                    Déposer une annonce
                </a>
            </div>
        </div>
    </section>
{% endblock %}
