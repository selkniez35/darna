<article class="group relative">
    <div class="relative aspect-[4/3] overflow-hidden arch sm:aspect-[4/5] bg-sand-200">
        <div class="absolute inset-0 zellige bg-majorelle-600 opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
        <div class="absolute inset-0 flex items-center justify-center text-sand-300 transition-colors duration-500 group-hover:text-white/80">
            {% include 'home/_category_icon.html.twig' with { slug: listing.category.slug, class: 'size-14' } %}
        </div>
        <span class="absolute bottom-4 left-4 rounded-full bg-sand-50/95 px-3 py-1 text-xs font-medium text-ink-700 shadow-sm">
            {{ listing.category.name }}
        </span>
    </div>
    <div class="mt-4 flex items-start justify-between gap-4">
        <div class="min-w-0">
            <h3 class="truncate font-medium text-ink-900">
                <a href="{{ path('app_listing_show', { id: listing.id }) }}" class="after:absolute after:inset-0 focus:outline-none">
                    {{ listing.title }}
                </a>
            </h3>
            <p class="mt-1 flex items-center gap-1.5 text-sm text-ink-500">
                <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5a7 7 0 1 0-14 0C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.3"/></svg>
                {{ listing.city }}
            </p>
        </div>
        <p class="shrink-0 font-display text-lg font-semibold text-clay-600">
            {{ listing.price|number_format(0, ',', ' ') }}&nbsp;<span class="text-sm font-medium">DH</span>
        </p>
    </div>
</article>
